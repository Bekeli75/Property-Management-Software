APP_NAME=Propentra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

CLIENT_DATABASE=mysql
CLIENT_DATABASE_HOST=127.0.0.1
CLIENT_DATABASE_PORT=3306
CLIENT_DATABASE_DATABASE=propentra
CLIENT_DATABASE_USERNAME=root
CLIENT_DATABASE_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=propentra
MYSQL_USERNAME=root
MYSQL_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=propentra
DB_USERNAME=root
DB_PASSWORD=

# SQLite (for development)
# DB_CONNECTION=sqlite
# DB_DATABASE=database.sqlite

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
SANCTUM_TOKEN_EXPIRATION=60
SESSION_DOMAIN=localhost

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chapa Payment Integration (Test Environment)
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_TEST_MODE=true

# Frontend URL
FRONTEND_URL=http://localhost:3000
