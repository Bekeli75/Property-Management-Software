# Propentra API — production environment template
# Generated by deploy/backend/setup-vps.sh. NEVER commit real .env values.
APP_NAME=Propentra
APP_ENV=production
APP_KEY=__GENERATED_BY_KEY_GENERATE__
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://__API_DOMAIN__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

CLIENT_DATABASE=mysql
CLIENT_DATABASE_HOST=127.0.0.1
CLIENT_DATABASE_PORT=3306
CLIENT_DATABASE_DATABASE=__DB_NAME__
CLIENT_DATABASE_USERNAME=__DB_USER__
CLIENT_DATABASE_PASSWORD=__DB_PASSWORD__

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=__DB_NAME__
MYSQL_USERNAME=__DB_USER__
MYSQL_PASSWORD=__DB_PASSWORD__

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__

SANCTUM_STATEFUL_DOMAINS=__FRONTEND_HOST__
SANCTUM_TOKEN_EXPIRATION=60
SESSION_DOMAIN=null

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@__API_DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

# Chapa Payment Integration
# Start with test keys; flip to live keys (and CHAPA_TEST_MODE=false) only after
# merchant approval + UAT. Never put live keys in a test/staging env.
CHAPA_SECRET_KEY=__CHAPA_SECRET_KEY__
CHAPA_TEST_MODE=__CHAPA_TEST_MODE__

# Frontend origin (no trailing slash)
FRONTEND_URL=https://__FRONTEND_HOST__
CORS_ALLOWED_ORIGINS=https://__FRONTEND_HOST__